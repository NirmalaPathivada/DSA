#include<bits/stdc++.h>
using namespace std;

struct node{
    int val;
    node* left;
    node* right;
    node(int data){
        val=data;
        left=nullptr;
        right=nullptr;
    }
};
void preorder(node* temp){
    if(temp==nullptr){
        return;
    }
    cout<<temp->val<<endl;
    preorder(temp->left);
    preorder(temp->right);
}
int main(){
    node* temp=new node(2);
    temp->left=new node(3);
    temp->right=new node(4);
    temp->left->left=new node(5);
    temp->left->right=new node(6);
    temp->right->left=new node(7);
    temp->right->right=new node(8);
    preorder(temp);
}
